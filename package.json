{
  "name": "sasat",
  "version": "0.22.12",
  "repository": "https://github.com/nin138/sasat.git",
  "author": "nin138 <ninian138@gmail.com>",
  "license": "MIT",
  "bin": "dist/cli/index.mjs",
  "scripts": {
    "start": "env-cmd .env ts-node ./index.ts",
    "build": "tsdown",
    "format": "biome format --write",
    "check": "biome check --write",
    "lint": "biome lint",
    "fix:order": "biome check --only=assist/source/organizeImports --write",
    "pretest": "yarn resetdb && yarn sasat migrate",
    "test": "env-cmd jest --coverage --silent=false --verbose false",
    "test:single": "env-cmd jest --silent=false --verbose false",
    "test:base": "node --experimental-vm-modules node_modules/.bin/jest",
    "resetdb": "docker-compose exec db sh -c \"mysql -u root < /docker-entrypoint-initdb.d/temp.sql\"",
    "prepare": "yarn build && husky",
    "sasat": "yarn env-cmd npx tsx src/cli/index.ts",
    "server": "yarn server:apollo",
    "server:apollo": "env-cmd --silent --no-override tsx ./test/testServer.ts",
    "server:yoga": "env-cmd --silent --no-override tsx ./test/yogaServer.ts",
    "codex": "docker compose exec dev codex codex --sandbox workspace-write --ask-for-approval on-request -c 'approvals_reviewer=\"auto_review\"'",
    "test:unit": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:typecheck": "tsc --project tsconfig.test.json --noEmit && tsc --project tsconfig.servers.json"
  },
  "dependencies": {
    "@biomejs/biome": "^2.5.14",
    "cac": "^7.0.0",
    "chalk": "^6.0.0",
    "esbuild": "^0.28.2",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^3.0.0",
    "hashids": "^2.3.0",
    "js-yaml": "^5.4.2",
    "mysql2": "^3.24.4",
    "pluralize": "^8.0.0",
    "sqlstring": "^2.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.8",
    "@types/pluralize": "0.0.33",
    "@types/sqlstring": "2.3.2",
    "env-cmd": "^11.0.0",
    "globals": "^17.12.0",
    "graphql-yoga": "^5.24.1",
    "husky": "9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.5.1",
    "sasat": "link:./dist",
    "ts-jest": "^29.4.13",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "@apollo/server": "^4.0.0 || ^5.0.0"
  },
  "resolutions": {
    "qs": "^6.16.0",
    "tar": "^7.5.22",
    "undici": "~6.28.1"
  },
  "lint-staged": {
    "*.ts": [
      "yarn check --no-errors-on-unmatched"
    ]
  },
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./migration": {
      "import": "./dist/migration/index.mjs",
      "require": "./dist/migration/index.cjs"
    },
    "./testing": {
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.cjs"
    }
  },
  "main": "dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "volta": {
    "node": "24.15.0"
  },
  "engines": {
    "node": ">=22"
  }
}
