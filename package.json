{
  "name": "sasat",
  "version": "0.22.3",
  "repository": "https://github.com/nin138/sasat.git",
  "author": "nin138 <ninian138@gmail.com>",
  "license": "MIT",
  "bin": "dist/cli/index.mjs",
  "scripts": {
    "start": "env-cmd .env ts-node ./index.ts",
    "build": "tsdown",
    "format": "biome format --write",
    "check": "biome check --write",
    "lint": "biome lint",
    "fix:order": "biome check --only=assist/source/organizeImports --write",
    "pretest": "yarn resetdb && yarn sasat migrate",
    "test": "env-cmd jest --coverage --silent=false --verbose false",
    "test:single": "env-cmd jest --silent=false --verbose false",
    "test:base": "node --experimental-vm-modules node_modules/.bin/jest",
    "resetdb": "docker-compose exec db sh -c \"mysql -u root < /docker-entrypoint-initdb.d/temp.sql\"",
    "prepare": "yarn build && husky install",
    "sasat": "yarn env-cmd tsx src/cli/index.ts",
    "server": "yarn env-cmd ts-node-esm -r tsconfig-paths/register ./test/testServer.ts"
  },
  "dependencies": {
    "@biomejs/biome": "^2.4.15",
    "cac": "^6.7.14",
    "chalk": "^5.3.0",
    "esbuild": "^0.28.0",
    "graphql": "^16.8.1",
    "graphql-subscriptions": "^2.0.0",
    "hashids": "^2.3.0",
    "js-yaml": "^4.1.1",
    "mysql2": "^3.22.3",
    "pluralize": "^8.0.0",
    "sqlstring": "^2.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@types/jest": "29.5.12",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^25.7.0",
    "@types/pluralize": "0.0.33",
    "@types/sqlstring": "2.3.2",
    "env-cmd": "10.1.0",
    "globals": "^17.4.0",
    "husky": "8.0.3",
    "jest": "^30.2.0",
    "lint-staged": "13.3.0",
    "sasat": "link:./dist",
    "ts-jest": "^29.4.6",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.20.3"
  },
  "peerDependencies": {
    "@apollo/server": "^4.0.0 || ^5.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "yarn check"
    ]
  },
  "type": "module",
  "packageManager": "yarn@3.8.2",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "volta": {
    "node": "24.15.0"
  }
}
